# Required for chat and Grok Voice
XAI_API_KEY=

# Optional custom Grok voice id
GROK_VOICE_ID=

# Optional, improves GitHub stats API rate limits
GITHUB_TOKEN=

# Optional, comma-separated allowlist beyond same-origin and parzival.live
ALLOWED_API_ORIGINS=

# Optional, only needed when running scripts/verify-amplify-apis.mjs
PRODUCTION_BASE_URL=
