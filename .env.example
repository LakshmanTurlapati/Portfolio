# Portfolio V2 Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Fly.io deployment, set server secrets with `fly secrets set`.

# OpenRouter API Key (required for chat and site-control responses)
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ElevenLabs API Key (required for voice STT/TTS features)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Concierge ES256 signing pair (required for signed voice site control)
# Generate both values with: npm run concierge:keys
CONCIERGE_ES256_PRIVATE_KEY_PEM_B64=base64_encoded_pkcs8_private_key
CONCIERGE_ES256_PUBLIC_KEY_PEM_B64=base64_encoded_spki_public_key

# GitHub token (optional, improves GitHub stats API rate limits)
GITHUB_TOKEN=your_github_token_here

# Optional comma-separated allowlist for paid API route callers beyond same-origin and parzival.live
ALLOWED_API_ORIGINS=https://parzival.live,https://parzival.live

# Production API verification base URL (only needed when running scripts/verify-production-apis.mjs)
PRODUCTION_BASE_URL=https://your-production-domain.example
