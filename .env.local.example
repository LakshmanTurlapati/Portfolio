# Required for chat and site-control responses
OPENROUTER_API_KEY=

# Required for voice STT/TTS features
ELEVENLABS_API_KEY=

# Required for signed Concierge browser actions; generate with `npm run concierge:keys`
CONCIERGE_ES256_PRIVATE_KEY_PEM_B64=
CONCIERGE_ES256_PUBLIC_KEY_PEM_B64=

# Optional, improves GitHub stats API rate limits
GITHUB_TOKEN=

# Optional, comma-separated allowlist beyond same-origin and parzival.live
ALLOWED_API_ORIGINS=

# Optional, only needed when running scripts/verify-production-apis.mjs
PRODUCTION_BASE_URL=
