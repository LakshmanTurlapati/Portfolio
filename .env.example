# Portfolio V2 Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For AWS Amplify deployment:
#   Set these in the Amplify Console under Environment Variables.
#   The amplify.yml build spec injects them into .env.production at build time.

# xAI Grok API Key (required for chat and site-control responses)
# Get your key at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# ElevenLabs API Key (required for voice STT/TTS features)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# GitHub token (optional, improves GitHub stats API rate limits)
GITHUB_TOKEN=your_github_token_here

# Production API verification base URL (only needed when running scripts/verify-amplify-apis.mjs)
PRODUCTION_BASE_URL=https://your-production-domain.example
